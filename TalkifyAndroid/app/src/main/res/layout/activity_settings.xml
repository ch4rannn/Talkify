<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/topbar_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_md">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/space_sm" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_lg">

            <!-- Profile Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PROFILE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/space_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_received"
                android:padding="@dimen/space_md"
                android:layout_marginBottom="@dimen/space_lg">

                <!-- Avatar Upload UI -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="@dimen/space_md">

                    <androidx.cardview.widget.CardView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        app:cardCornerRadius="40dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/bg">
                        <ImageView
                            android:id="@+id/avatarImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="?attr/selectableItemBackground" />
                    </androidx.cardview.widget.CardView>

                    <ImageButton
                        android:id="@+id/editAvatarButton"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_bubble_sent"
                        android:src="@android:drawable/ic_menu_edit"
                        android:padding="4dp"
                        app:tint="@color/text_primary"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Display Name"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:padding="@dimen/space_sm"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:hint="Your Name"
                    android:textColorHint="@color/text_secondary"
                    android:singleLine="true"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status Message"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="@dimen/space_md"/>

                <EditText
                    android:id="@+id/editStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:padding="@dimen/space_sm"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_primary"
                    android:hint="What's on your mind?"
                    android:textColorHint="@color/text_secondary"
                    android:singleLine="true"/>
            </LinearLayout>

            <!-- Appearance Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APPEARANCE"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/space_sm"
                android:layout_marginTop="@dimen/space_md"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_received"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDarkMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dark Mode"
                    android:textColor="@color/text_primary"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"/>

            </LinearLayout>

            <!-- Chat Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHAT SETTINGS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/space_sm"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_received"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchTimestamps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Show Timestamps"
                    android:textColor="@color/text_primary"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchEnterToSend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enter to Send"
                    android:textColor="@color/text_primary"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto-scroll"
                    android:textColor="@color/text_primary"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"/>

            </LinearLayout>

            <!-- Notifications Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOTIFICATIONS"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/space_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_received"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="@dimen/space_sm"
                android:paddingBottom="@dimen/space_sm"
                android:layout_marginBottom="@dimen/space_lg">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchNotifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Enable Notifications"
                    android:textColor="@color/text_primary"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"/>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" android:layout_marginTop="4dp" android:layout_marginBottom="4dp"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMessageSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Message Sound"
                    android:textColor="@color/text_primary"
                    android:paddingTop="@dimen/space_sm"
                    android:paddingBottom="@dimen/space_sm"/>

            </LinearLayout>

            <!-- Account Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCOUNT"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:layout_marginBottom="@dimen/space_sm"
                android:layout_marginTop="@dimen/space_md"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Clear All Chat History"
                app:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                android:layout_marginTop="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Log Out"
                app:backgroundTint="#e53935"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Talkify v2.0.0"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
